{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["@tessoa/plugin-sdk"],
    "jsx": "react-jsx",
    "jsxImportSource": "@tessoa/plugin-sdk",
    "strict": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
